{
  "name": "my_erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/domain.test.ts tests/progreso.test.ts tests/precio.test.ts tests/presupuesto.test.ts tests/schema.test.ts tests/granola-parse.test.ts tests/granola-source.test.ts tests/meeting-repo.test.ts tests/citation.test.ts tests/contracts.test.ts tests/consulta.test.ts tests/anonimizar.test.ts tests/llm.test.ts tests/extract-topics.test.ts tests/triage.test.ts tests/rubric.test.ts tests/tools.test.ts tests/repos.test.ts tests/detect-repos.test.ts tests/opencode.test.ts tests/broadcast.test.ts tests/markdown.test.ts tests/orden-reuniones.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "auth:granola": "node --env-file-if-exists=.env --import tsx src/cli/auth-granola.ts",
    "ingest": "node --env-file-if-exists=.env --import tsx src/cli/ingest.ts",
    "meetings": "node --env-file-if-exists=.env --import tsx src/cli/meetings.ts",
    "topics:extract": "node --env-file-if-exists=.env --import tsx src/cli/extract-topics.ts",
    "traces": "node --env-file-if-exists=.env --import tsx src/cli/traces.ts",
    "topics": "node --env-file-if-exists=.env --import tsx src/cli/topics.ts",
    "rubric": "node --env-file-if-exists=.env --import tsx src/cli/rubric.ts",
    "items": "node --env-file-if-exists=.env --import tsx src/cli/items.ts",
    "repos": "node --env-file-if-exists=.env --import tsx src/cli/repos.ts",
    "repos:seed": "node --env-file-if-exists=.env --import tsx scripts/seed-repos.ts",
    "plan": "node --env-file-if-exists=.env --import tsx src/cli/plan.ts",
    "broadcast": "node --env-file-if-exists=.env --import tsx src/cli/broadcast.ts",
    "web": "node --env-file-if-exists=.env --import tsx src/web/server.ts",
    "diag:importar": "tsx src/app/importar-diagnostico.ts",
    "plan:importar": "tsx src/app/importar-plan.ts",
    "dev": "tsx src/web/server.ts",
    "free": "kill-port 4599 || echo libre"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.87",
    "@modelcontextprotocol/client": "^2.4.0",
    "@opencode-ai/sdk": "^1.19.6",
    "ai": "^7.0.173",
    "better-sqlite3": "12.4.1",
    "drizzle-orm": "0.44.6",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.13",
    "drizzle-kit": "0.31.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
