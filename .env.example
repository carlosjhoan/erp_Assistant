# Base de datos. Un archivo, fuera del repo.
DATABASE_PATH=./data/my_erp.db

# Modelos: generativo (OpenRouter o DeepSeek) + Jev para decisiones.
# openrouter | deepseek. Sin definir, usa openrouter si hay OPENROUTER_API_KEY.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Ruteo de OpenRouter: price | throughput | latency. price evita caer en un proveedor caro.
OPENROUTER_SORT=price
# none | low | high. none evita gastar tokens en razonamiento y hace predecible el JSON.
OPENROUTER_REASONING=none
OPENROUTER_APP_NAME=my_erp
OPENROUTER_SITE_URL=https://github.com/carlosjhoan/erp_Assistant

# Legacy: DeepSeek directo. Solo se usa si LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# DeepSeek directo: no toques esta URL. Otro proveedor: su URL y un modelo con prefijo.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash razona por defecto (effort high). Para JSON predecible: disabled.
DEEPSEEK_THINKING=disabled
# Intentos totales por llamada (1 = sin reintento).
LLM_MAX_ATTEMPTS=3
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Umbral de Jev por debajo del cual el ítem queda needs_review.
JEV_THRESHOLD=0.6

# Presupuesto del asistente: pasos del loop y topes de gasto.
CONSULTA_MAX_STEPS=6
CONSULTA_MAX_USD_TURNO=0.05
CONSULTA_MAX_USD_DIA=2

# Correo: dry_run por defecto (no envía, escribe el .eml).
DRY_RUN=1
MAIL_FROM=
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# Granola: el ERP tiene su propia credencial OAuth (npm run auth:granola).
GRANOLA_OAUTH_PORT=19876

# Solo se ingesta la nota cuyo título contenga este texto. Vacío = todas.
INGEST_TITLE_MATCH=Landing page activation plan

# OpenCode: el ERP le manda el alcance a cada repo por su API local.
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_PROVIDER=opencode-go
OPENCODE_MODEL=deepseek-v4.1-flash
# Agente de solo lectura: lo usa el broadcast. explore niega ediciones y cuesta ~8x menos.
OPENCODE_AGENT_TO_EXPLORE=explore
# Agente con permiso de escritura: lo usara la implementacion, nunca el broadcast.
OPENCODE_AGENT_TO_EDIT=gentle-orchestrator
OPENCODE_TIMEOUT_MS=300000
# Sesiones concurrentes contra el servidor local.
OPENCODE_MAX_PARALLEL=2
