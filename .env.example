# Base de datos. Un archivo, fuera del repo.
DATABASE_PATH=./data/my_erp.db

# Modelos: DeepSeek compone, Jev verifica.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Umbral de Jev por debajo del cual el ítem queda needs_review.
JEV_THRESHOLD=0.6

# Correo: dry_run por defecto (no envía, escribe el .eml).
DRY_RUN=1
MAIL_FROM=
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# Granola: el ERP tiene su propia credencial OAuth (npm run auth:granola).
GRANOLA_OAUTH_PORT=19876

# Solo se ingesta la nota cuyo título contenga este texto. Vacío = todas.
INGEST_TITLE_MATCH=Landing page activation plan
